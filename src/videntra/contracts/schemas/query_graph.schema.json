{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videntra.local/schemas/query-graph.v1.json",
  "title": "VIDENTRA QueryGraph v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "original_query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "language": {
      "enum": [
        "vi",
        "en",
        "mixed",
        "unknown"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "maxItems": 16
    },
    "predicates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicate"
      },
      "maxItems": 32
    },
    "logic": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/logic"
      },
      "maxItems": 16
    },
    "root_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    },
    "residual_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 32
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "validated",
            "fallback"
          ]
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": "string"
        },
        "confidence_kind": {
          "const": "uncalibrated"
        }
      },
      "required": [
        "status",
        "model_revision",
        "prompt_version",
        "confidence_kind"
      ]
    }
  },
  "required": [
    "schema_version",
    "original_query",
    "language",
    "entities",
    "predicates",
    "logic",
    "root_id",
    "ambiguities",
    "residual_constraints",
    "parser"
  ],
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "person",
            "object",
            "text_region",
            "place",
            "unknown"
          ]
        },
        "mention": {
          "type": "string"
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "source_span": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value",
              "source_span"
            ]
          },
          "maxItems": 16
        },
        "coreference_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        }
      },
      "required": [
        "id",
        "type",
        "mention",
        "attributes",
        "coreference_of",
        "uncertainty"
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "attribute",
            "action",
            "spatial",
            "temporal",
            "ocr",
            "asr",
            "identity",
            "free_text"
          ]
        },
        "operator": {
          "type": "string"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "object": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "recipient": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "actor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "reference": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "event_a": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "event_b": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "speaker": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "text_entity": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_span": {
          "type": "string"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "modality_options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "visual",
                "ocr",
                "asr",
                "audio_visual"
              ]
            }
          }
        },
        "scope": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "anchor_predicate_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "min_gap_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "max_gap_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "quantifier": {
                  "enum": [
                    "exists",
                    "forall_observed"
                  ]
                }
              },
              "required": [
                "anchor_predicate_id",
                "min_gap_ms",
                "max_gap_ms",
                "quantifier"
              ]
            }
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8
        }
      },
      "required": [
        "id",
        "kind",
        "operator",
        "roles",
        "value",
        "source_span",
        "polarity",
        "modality_options",
        "scope",
        "confidence",
        "uncertainty"
      ]
    },
    "logic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "op": {
          "enum": [
            "AND",
            "OR",
            "NOT"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "id",
        "op",
        "children"
      ]
    }
  }
}
