# ==============================================================================
# VIDENTRA Runtime Environment Configuration Template
# Copy this file to .env and customize for your workstation or GPU server.
# ==============================================================================

# Compute device: "auto" (uses CUDA if available, else CPU), "cuda", or "cpu"
VIDENTRA_DEVICE=auto

# Tensor precision on CUDA: "auto" (float16 on CUDA for 6GB VRAM, float32 on CPU),
# or explicitly "float16", "bfloat16", "float32"
VIDENTRA_DTYPE=auto

# Core index & model paths (relative paths resolve from project root)
VIDENTRA_DB_PATH=data/processed/catalog/corpus_metadata.db
VIDENTRA_FAISS_PATH=data/processed/visual_keyframes/siglip2_keyframes_768d.faiss
VIDENTRA_MODEL_DIR=models/siglip2

# Multilingual E5-small lexical-dense encoder revision (local cache by default)
VIDENTRA_E5_MODEL_ID=intfloat/multilingual-e5-small
VIDENTRA_E5_REVISION=c007d7ef6fd86656326059b28395a7a03a7c5846

# Optional Stage 1 Small-LLM Query Decomposer (Qwen2.5-1.5B-Instruct)
# Default disabled (0): Stage 1 uses deterministic <1ms rule-based decomposition.
VIDENTRA_LLM_ENABLED=0
# VIDENTRA_LLM_MODEL_PATH=models/llm/qwen2.5-1.5b-instruct
VIDENTRA_LLM_DEADLINE_MS=250

# Optional offline evidence extraction model overrides
# VIDENTRA_ASR_MODEL_DIR=models/asr/phowhisper-small
# VIDENTRA_VIETOCR_WEIGHTS=models/ocr/vgg_transformer.pth

# Optional CPU threading controls (mainly for deterministic CPU benchmarking)
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
